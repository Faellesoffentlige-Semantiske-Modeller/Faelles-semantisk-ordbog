PREFIX mdv: <https://data.gov.dk/model/core/metadata-dictionary-vocabulary/>

# All dictionary items (default graph) with the element they represent and the
# vocabulary they come from. One card per item.
SELECT ?item ?element ?vocabulary
WHERE {
  ?item a mdv:DictionaryItem ;
        mdv:representsElement ?element ;
        mdv:fromVocabulary ?vocabulary .
}
ORDER BY ?element
